# Copy to Utilities/cloudflare.local.env and fill in the R2 credentials from Cloudflare.
# Keep the real file local; it is ignored by Git.
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=lexico-audio-storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional, if the bucket uses a jurisdiction-specific endpoint.
R2_ENDPOINT=
