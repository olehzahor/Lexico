      "sentences": [
        {
          "id": 401,
          "sentences": [
            {
              "text": "We need an alternative solution because the original plan failed.",
              "language": "en"
            },
            {
              "text": "Нам нужен альтернативный вариант, потому что первоначальный план не сработал.",
