      "sentences": [
        {
          "id": 201,
          "sentences": [
            {
              "text": "I read a book before I go to sleep every night.",
              "language": "en"
            },
            {
              "text": "Я читаю книгу перед сном каждую ночь.",
              "language": "ru"
            }
          ]
        },
        {
          "id": 202,
          "sentences": [
            {
              "text": "She bought a new book from the small shop on Main Street.",
              "language": "en"
            },
            {
              "text": "Она купила новую книгу в небольшом магазине на Главной улице.",
              "language": "ru"
            }
          ]
        },
        {
          "id": 203,
          "sentences": [
            {
              "text": "The teacher gave each student a book to study for the test.",
              "language": "en"
            },
            {
              "text": "Учитель дал каждому ученику книгу для подготовки к тесту.",
              "language": "ru"
            }
          ]
        },
        {
          "id": 204,
          "sentences": [
            {
              "text": "My brother likes to draw pictures inside his favorite book.",
              "language": "en"
            },
            {
              "text": "Моему брату нравится рисовать картинки в своей любимой книге.",
              "language": "ru"
            }
          ]
        },
        {
          "id": 205,
          "sentences": [
            {
              "text": "We opened the book and looked at the colorful pictures together.",
              "language": "en"
            },
            {
              "text": "Мы открыли книгу и вместе посмотрели на яркие картинки.",
              "language": "ru"
            }
          ]
        },
        {
          "id": 206,
          "sentences": [
            {
              "text": "Can you please bring the book to the library tomorrow morning?",
              "language": "en"
            },
            {
              "text": "Не могли бы вы принести книгу в библиотеку завтра утром?",
              "language": "ru"
            }
          ]
        },
        {
          "id": 207,
          "sentences": [
            {
              "text": "The little girl found a hidden book under the bed yesterday.",
              "language": "en"
            },
            {
              "text": "Вчера маленькая девочка нашла спрятанную книгу под кроватью.",
              "language": "ru"
            }
          ]
        },
        {
          "id": 208,
          "sentences": [
            {
              "text": "He writes his name on the cover of every book he owns.",
              "language": "en"
            },
            {
              "text": "Он пишет своё имя на обложке каждой своей книги.",
              "language": "ru"
            }
          ]
        },
        {
          "id": 209,
          "sentences": [
            {
              "text": "During the trip, I carried a small book in my backpack.",
              "language": "en"
            },
            {
              "text": "Во время поездки я носил небольшую книгу в рюкзаке.",
              "language": "ru"
            }
          ]
        },
        {
          "id": 210,
          "sentences": [
            {
              "text": "They shared one book and read it aloud at the park.",
              "language": "en"
            },
            {
              "text": "Они делились одной книгой и читали её вслух в парке.",
              "language": "ru"
            }
          ]
