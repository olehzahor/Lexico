      "sentences": [
        {
          "id": 101,
          "sentences": [
            {
              "text": "He likes to play soccer after school with his friends.",
              "language": "en"
            },
            {
              "text": "Он любит играть в футбол после школы с друзьями.",
              "language": "ru"
            }
