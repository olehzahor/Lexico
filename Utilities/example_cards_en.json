        {
          "id": 402,
          "sentences": [
            {
              "text": "She offered an alternative route that avoided the heavy traffic.",
              "language": "en"
            },
            {
              "text": "Она предложила альтернативный маршрут, который избегал сильной пробки.",
              "language": "ru"
            }
          ]
        },
        {
          "id": 403,
          "sentences": [
            {
              "text": "The teacher suggested an alternative method for solving the math problem.",
